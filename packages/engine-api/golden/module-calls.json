    { "name": "listModulePlaces", "arity": 1, "optionalArgs": 0, "channel": "bowerloom-modules:listModulePlaces", "returns": "plain" },
    { "name": "approveModulePlace", "arity": 1, "optionalArgs": 0, "channel": "bowerloom-modules:approveModulePlace", "returns": "plain" },
    { "name": "revokeModulePlace", "arity": 2, "optionalArgs": 0, "channel": "bowerloom-modules:revokeModulePlace", "returns": "plain" },
    { "name": "readModuleFile", "arity": 3, "optionalArgs": 0, "channel": "bowerloom-modules:readModuleFile", "returns": "plain" }
  ],
  "moduleCallRefusals": ["NOT_ALLOWED", "BAD_ARGUMENT", "UNKNOWN_MODULE", "NOT_APPROVED", "PLACE_CHANGED", "BAD_PATH", "OUTSIDE_PLACE", "NOT_A_FILE", "TOO_LARGE", "NOT_TEXT", "UNREADABLE", "HOME_UNREADABLE", "RECORD_DAMAGED", "RECORD_BLOCKED"]
