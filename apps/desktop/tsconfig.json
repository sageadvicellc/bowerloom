{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "../..",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "renderer/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
