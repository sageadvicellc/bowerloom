{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "../..",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "renderer/**/*.ts",
    "renderer/**/*.tsx", "renderer/**/*.d.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "tests/component/**/*.tsx",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
