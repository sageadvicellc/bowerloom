{
  "name": "@sagetrellis/trellis",
  "version": "0.7.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "trellis": "dist/apps/cli/src/main.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js packages/broker-postgres/test/*.test.mjs packages/workspace-effects/test/*.test.mjs packages/admission/test/*.test.mjs",
    "trellis": "node dist/apps/cli/src/main.js",
    "test:broker-postgres": "npm run build && node --test packages/broker-postgres/test/*.test.mjs",
    "test:workspace-effects": "npm run build && node --test packages/workspace-effects/test/*.test.mjs",
    "test:admission": "npm run build && node --test packages/admission/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "typescript": "7.0.2"
  }
}
